# --- data -------------------------------------------------------------------
# analytics: raw cache, Parquet, manifests, media and scouting.sqlite are regenerated by
# `make demo-data` / `make -C services/analytics ingest`; never committed.
/data/analytics/
# fantasy: real snapshots, live league data and sessions stay local; demo fixtures and
# CSV templates under data/fantasy/{demo,templates} are tracked.
/data/fantasy/nba/*
!/data/fantasy/nba/.gitkeep
/data/fantasy/cache/
/data/fantasy/sessions/*
!/data/fantasy/sessions/.gitkeep
*.sqlite-journal
# local analysis exports
/exports/
*.xlsx

# --- secrets / local config -------------------------------------------------
.env
.env.local
services/*/.env

# --- python -----------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# --- node -------------------------------------------------------------------
node_modules/
dist/
coverage/
.vite/
test-results/
playwright-report/

# --- generated media / verification scratch --------------------------------
# demo-tour.mjs records raw Playwright video here; the encoded GIF/MP4 under docs/media are tracked
/docs/media/raw/
*.webm
# ad-hoc capture and survey scripts
frontend/scripts/*.tmp.mjs
frontend/scripts/.tmp-*
# playwright artifacts written outside test-results when --output is used
.playwright-artifacts/

# --- os / editor / agent scratch -------------------------------------------
.DS_Store
.idea/
.vscode/
*.log
.playwright-mcp/
.superpowers/
