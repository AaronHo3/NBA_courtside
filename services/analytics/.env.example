# Copy to services/analytics/.env (the service reads it). All values optional; defaults shown.

# Where Parquet, raw cache and manifest live (relative to the courtside repo root, or absolute).
NBA_DATA_DIR=./data/analytics
# auto: use real `nba` namespace when its manifest has data, else fall back to labeled `demo`.
# Force with `nba` or `demo`.
NBA_NAMESPACE=auto

# Provider pacing (stats.nba.com is rate-limited and blocks aggressive clients).
NBA_REQUEST_DELAY_SECONDS=1.5
NBA_REQUEST_TIMEOUT_SECONDS=30
NBA_MAX_RETRIES=4
# Optional outbound HTTP(S) proxy for the provider, e.g. http://user:pass@host:port
NBA_PROXY=

# Managed media (Phase B). ffmpeg/ffprobe must be installed (brew install ffmpeg); without them
# uploads are registered but never processed and the UI says so.
MEDIA_MAX_UPLOAD_BYTES=4294967296
MEDIA_MAX_DURATION_MS=14400000
MEDIA_MAX_PIXELS=8294400
MEDIA_PURGE_AFTER_DAYS=7
MEDIA_REFERENCE_STALE_AFTER_DAYS=30

# Durable jobs: JOBS_INLINE=1 runs queued jobs in the API process (dev/tests); otherwise run `make worker`.
JOBS_INLINE=0
JOBS_LEASE_SECONDS=60
JOBS_POLL_SECONDS=2

# API server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
